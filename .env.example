EGE_ENVIRONMENT=development
EGE_DATABASE_URL=postgresql+asyncpg://ege:ege_dev_password@localhost:5432/ege
EGE_JWT_SECRET=replace-with-at-least-32-random-characters
EGE_JWT_ALGORITHM=HS256
EGE_ACCESS_TOKEN_TTL_MINUTES=15
EGE_REFRESH_TOKEN_TTL_DAYS=30
EGE_EMAIL_CODE_TTL_MINUTES=10
EGE_REFRESH_COOKIE_NAME=refresh_token
EGE_ALLOWED_ORIGINS=["http://localhost:3000","http://localhost:5173"]
EGE_OPENAPI_CONTRACT_PATH=../api/openapi.yaml
EGE_MEDIA_ROOT=../data/media

# Отправка кодов входа на почту. Без SMTP в development код виден в консоли.
# Для production SMTP обязателен; EGE_SMTP_SSL=false использует STARTTLS.
EGE_SMTP_HOST=
EGE_SMTP_PORT=465
EGE_SMTP_SSL=true
EGE_SMTP_USERNAME=
EGE_SMTP_PASSWORD=
EGE_SMTP_FROM=

# Почта может быть указана в кабинете администратора; значение ниже — резервное.
EGE_ADMIN_NOTIFICATION_EMAIL=
# Адрес платформы для ссылки в письме администратору.
EGE_PUBLIC_BASE_URL=http://127.0.0.1:8000
